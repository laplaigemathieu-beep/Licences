# Copie ce fichier en .env.local pour tester sur ton ordinateur.
# Sur Vercel, ces valeurs se collent dans Settings > Environment Variables.

# Lien de paiement Stripe (Payment Link), commence par https://buy.stripe.com/
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# E-mail public de contact (affiché sur le site, mentions légales, garantie)
NEXT_PUBLIC_CONTACT_EMAIL=
